{
  "name": "pkmn-roguelike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:import": "node tools/import-assets.ts",
    "assets:manifest": "node tools/build-asset-manifest.ts",
    "check": "npm run typecheck && npm test && npm run build && npm run report:check",
    "data:movesets": "node tools/import-movesets.ts",
    "data:moves": "node tools/import-moves.ts",
    "data:species": "node tools/import-species.ts",
    "data:bosses": "node tools/build-boss-teams.ts",
    "data:trainer-perks": "node tools/import-trainer-perks.ts && node tools/build-quests.ts && node tools/build-trainer-unlocks.ts",
    "data:custom": "node tools/import-custom-forms.ts",
    "data:abilities": "node tools/import-abilities.ts",
    "data:availability": "node tools/import-availability.ts",
    "data:rival-catalog": "node tools/import-rival-catalog.ts",
    "data:anims": "node tools/import-battle-anims.ts",
    "data:megas": "node tools/build-mega-stones.ts",
    "data:zmoves": "node tools/build-z-moves.ts",
    "data:maxmoves": "node tools/build-max-moves.ts",
    "assets:z-icons": "node tools/draw-z-icons.ts",
    "report:content": "node tools/report-content.ts",
    "report:dashboard": "node tools/report-content.ts --write --html",
    "report:check": "node tools/report-content.ts --check",
    "report:balance": "node tools/report-balance.ts",
    "report:economy": "node tools/report-economy.ts",
    "data:events": "node tools/build-events.ts",
    "data:quests": "node tools/build-quests.ts",
    "data:trainer-unlocks": "node tools/build-trainer-unlocks.ts",
    "data:game-events": "node tools/build-game-events.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.5",
    "typescript": "~5.9",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "phaser": "3.90.0",
    "zod": "^4.6.7"
  }
}
