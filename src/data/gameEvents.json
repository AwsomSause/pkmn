  {
   "id": "delta-research-week",
   "version": 1,
   "name": "Delta Research Week",
   "kind": "weekly",
   "description": "Strange readings across the regions: find clues at events, win research battles and study rare Pokémon.",
   "schedule": {
    "kind": "weeklyRotation"
   },
   "seedRule": "isoWeek",
   "progressionEligibility": true,
   "eligibility": {
    "minRunsFinished": 0
   },
   "mode": "any",
   "ruleText": "Rare Pokémon turn up 50% more often; mysteries and odd signals appear on the map more often.",
   "modifiers": [
    {
     "kind": "encounterWeightMultiplier",
     "group": "rare",
     "value": 1.5
    }
   ],
   "mapEvents": [
    "time-rift",
    "meteorite-crash",
    "abandoned-lab",
    "strange-signal",
    "distortion-world"
   ],
   "objectives": [
    {
     "id": "clues",
     "text": "Find 3 clues (finish 3 map events)",
     "counter": "eventsCompleted",
     "atLeast": 3,
     "reward": {
      "researchPoints": 40
     }
    },
    {
     "id": "research-battles",
     "text": "Win 15 research battles against trainers",
     "counter": "trainersDefeated",
     "atLeast": 15,
     "reward": {
      "researchPoints": 60
     }
    },
    {
     "id": "samples",
     "text": "Catch 8 Pokémon for study",
     "counter": "pokemonCaught",
     "atLeast": 8,
     "reward": {
      "researchPoints": 60
     }
    },
    {
     "id": "report",
     "text": "Report to 3 gym leaders (beat them)",
     "counter": "gymLeadersDefeated",
     "atLeast": 3,
     "reward": {
      "researchPoints": 80
     }
    }
   ],
   "reward": {
    "researchPoints": 300,
    "title": "Delta Researcher",
    "pool": "rare"
   },
   "repeatPolicy": "oncePerEvent",
   "fallbackReward": {
    "researchPoints": 150,
    "candies": 10
   },
   "visualTheme": {
    "color": "#7a5cff",
    "icon": "item.scanner"
   },
   "contentTags": [
    "delta",
    "research"
   ]
  },
